+import { ArrayMaxSize, IsArray, IsBoolean, IsIn, IsOptional, IsString, MaxLength } from 'class-validator';
+import { BOOK_REQUEST_PUSH_EVENTS, BOOK_REQUEST_PUSH_PRIORITIES } from '@bookorbit/types';
+import type { BookRequestPushEvent, BookRequestPushPriority } from '@bookorbit/types';
+
+const MAX_KEY_LENGTH = 100;
+
+export class UpdatePushSettingsDto {
+  @IsOptional()
+  @IsBoolean()
+  enabled?: boolean;
+
+  @IsOptional()
+  @IsArray()
+  @ArrayMaxSize(BOOK_REQUEST_PUSH_EVENTS.length)
+  @IsIn(BOOK_REQUEST_PUSH_EVENTS, { each: true })
+  events?: BookRequestPushEvent[];
+
+  @IsOptional()
+  @IsIn(BOOK_REQUEST_PUSH_PRIORITIES)
+  priority?: BookRequestPushPriority;
+
+  @IsOptional()
+  @IsString()
+  @MaxLength(MAX_KEY_LENGTH)
+  appToken?: string;
+
+  @IsOptional()
+  @IsString()
+  @MaxLength(MAX_KEY_LENGTH)
+  userKey?: string;
+}
+
+export class TestPushDto {
+  @IsOptional()
+  @IsString()
+  @MaxLength(MAX_KEY_LENGTH)
+  appToken?: string;
+
+  @IsOptional()
+  @IsString()
+  @MaxLength(MAX_KEY_LENGTH)
+  userKey?: string;
+}
