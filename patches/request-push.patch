+<script setup lang="ts">
+import { computed, onMounted, reactive, ref } from 'vue'
+import { useI18n } from 'vue-i18n'
+import { Loader2 } from '@lucide/vue'
+import { toast } from 'vue-sonner'
+import { BOOK_REQUEST_PUSH_EVENTS, BOOK_REQUEST_PUSH_PRIORITIES, NotificationType } from '@bookorbit/types'
+import type { BookRequestPushEvent, BookRequestPushPriority } from '@bookorbit/types'
+import ToggleSwitch from '@/components/ui/ToggleSwitch.vue'
+import { Button } from '@/components/ui/button'
+import SettingsRow from './components/SettingsRow.vue'
+import { useRequestPush } from '@/features/book-requests/composables/useRequestPush'
+import { SECRET_INPUT_ATTRS } from '@/lib/secret-input'
+
+const { t } = useI18n()
+const emit = defineEmits<{ encryptionState: [configured: boolean] }>()
+
+const { settings, loading, loadFailed, fetchSettings, save, sendTest } = useRequestPush()
+
+const EVENT_KEYS: Record<BookRequestPushEvent, string> = {
+  [NotificationType.BookRequestFailed]: 'failed',
+  [NotificationType.BookRequestNeedsReview]: 'needsReview',
+  [NotificationType.BookRequestNeedsRelease]: 'needsRelease',
+  [NotificationType.BookRequestSubmitted]: 'submitted',
+  [NotificationType.BookRequestAvailable]: 'available',
+}
+
+const PRIORITY_KEYS: Record<BookRequestPushPriority, string> = { [-1]: 'low', 0: 'normal', 1: 'high' }
+
+const draft = reactive({ appToken: '', userKey: '' })
+const secretsVisible = ref(false)
+const savingKeys = ref(false)
+const testing = ref(false)
+
+const keysDirty = computed(() => draft.appToken.trim() !== '' || draft.userKey.trim() !== '')
+const canTest = computed(
+  () => (draft.appToken.trim() !== '' || settings.value.hasAppToken) && (draft.userKey.trim() !== '' || settings.value.hasUserKey),
+)
+
+onMounted(async () => {
+  await fetchSettings()
+  emit('encryptionState', settings.value.encryptionConfigured)
+})
+
+async function persist(payload: Parameters<typeof save>[0]) {
+  if (await save(payload)) {
+    toast.success(t('settings.system.requests.push.saved'))
+    return true
+  }
+  toast.error(t('settings.system.requests.push.saveFailed'))
+  return false
+}
+
+function handleEnabledChange(enabled: boolean) {
+  void persist({ enabled })
+}
+
+function handleEventChange(event: BookRequestPushEvent, on: boolean) {
+  const next = on ? [...settings.value.events, event] : settings.value.events.filter((e) => e !== event)
+  void persist({ events: next })
+}
+
+function handlePriorityChange(e: Event) {
+  void persist({ priority: Number((e.target as HTMLSelectElement).value) as BookRequestPushPriority })
+}
+
+async function handleSaveKeys() {
+  savingKeys.value = true
+  const payload: { appToken?: string; userKey?: string } = {}
+  if (draft.appToken.trim()) payload.appToken = draft.appToken
+  if (draft.userKey.trim()) payload.userKey = draft.userKey
+  if (await persist(payload)) {
+    draft.appToken = ''
+    draft.userKey = ''
+  }
+  savingKeys.value = false
+}
+
+async function handleClearKeys() {
+  if (await persist({ appToken: '', userKey: '', enabled: false })) {
+    draft.appToken = ''
+    draft.userKey = ''
+  }
+}
+
+async function handleTest() {
+  testing.value = true
+  const result = await sendTest({ appToken: draft.appToken || undefined, userKey: draft.userKey || undefined })
+  testing.value = false
+  if (result.ok) toast.success(t('settings.system.requests.push.testOk'))
+  else
+    toast.error(
+      result.error ? t('settings.system.requests.push.testFailedDetail', { error: result.error }) : t('settings.system.requests.push.testFailed'),
+    )
+}
+</script>
+
+<template>
+  <div v-if="loading" class="settings-loading-state">
+    <Loader2 class="size-5 animate-spin text-muted-foreground" />
+    <span class="sr-only">{{ t('settings.system.requests.push.loading') }}</span>
+  </div>
+
+  <section v-else aria-labelledby="request-push-heading" class="space-y-3">
+    <h2 id="request-push-heading" class="sr-only">{{ t('settings.system.requests.push.title') }}</h2>
+
+    <p v-if="loadFailed" role="alert" class="text-sm text-destructive">{{ t('settings.system.requests.push.loadFailed') }}</p>
+
+    <div class="settings-card">
+      <div class="settings-card-header">
+        <span class="settings-card-title">{{ t('settings.system.requests.push.pushover') }}</span>
+        <span class="settings-state-pill">
+          {{ settings.enabled ? t('settings.system.requests.automation.stateOn') : t('settings.system.requests.automation.stateOff') }}
+        </span>
+      </div>
+
+      <p class="settings-hint settings-prose bg-card px-4 py-3 md:px-5">
+        {{ t('settings.system.requests.push.intro') }}
+        <a href="https://pushover.net/apps/build" target="_blank" rel="noopener noreferrer" class="underline">pushover.net</a>
+      </p>
+
+      <SettingsRow :label="t('settings.system.requests.push.enabled')" :hint="t('settings.system.requests.push.enabledShort')">
+        <ToggleSwitch
+          :model-value="settings.enabled"
+          :disabled="!settings.hasAppToken || !settings.hasUserKey"
+          :aria-label="t('settings.system.requests.push.enabled')"
+          @update:model-value="handleEnabledChange"
+        />
+      </SettingsRow>
+
+      <SettingsRow control-id="push-app-token" :label="t('settings.system.requests.push.appToken')">
+        <input
+          id="push-app-token"
+          v-model="draft.appToken"
+          v-bind="SECRET_INPUT_ATTRS"
+          type="text"
+          class="input-field w-full md:w-48"
+          :class="{ 'input-secret': !secretsVisible }"
+          :disabled="!settings.encryptionConfigured"
+          :placeholder="settings.hasAppToken ? t('settings.system.requests.push.keepStored') : ''"
+        />
+      </SettingsRow>
+
+      <SettingsRow control-id="push-user-key" :label="t('settings.system.requests.push.userKey')">
+        <input
+          id="push-user-key"
+          v-model="draft.userKey"
+          v-bind="SECRET_INPUT_ATTRS"
+          type="text"
+          class="input-field w-full md:w-48"
+          :class="{ 'input-secret': !secretsVisible }"
+          :disabled="!settings.encryptionConfigured"
+          :placeholder="settings.hasUserKey ? t('settings.system.requests.push.keepStored') : ''"
+        />
+      </SettingsRow>
+
+      <div class="flex flex-wrap justify-end gap-2 bg-card px-4 py-3 md:px-5">
+        <Button size="sm" variant="ghost" @click="secretsVisible = !secretsVisible">
+          {{ secretsVisible ? t('common.hide') : t('common.show') }}
+        </Button>
+        <Button v-if="settings.hasAppToken || settings.hasUserKey" size="sm" variant="outline" @click="handleClearKeys">
+          {{ t('settings.system.requests.push.clearKeys') }}
+        </Button>
+        <Button size="sm" variant="outline" :disabled="!canTest || testing" @click="handleTest">
+          <Loader2 v-if="testing" class="size-4 animate-spin" />
+          {{ t('settings.system.requests.push.sendTest') }}
+        </Button>
+        <Button size="sm" :disabled="!keysDirty || savingKeys || !settings.encryptionConfigured" @click="handleSaveKeys">
+          {{ t('settings.system.requests.push.saveKeys') }}
+        </Button>
+      </div>
+    </div>
+
+    <div class="settings-card">
+      <div class="settings-card-header">
+        <span class="settings-card-title">{{ t('settings.system.requests.push.events') }}</span>
+      </div>
+
+      <SettingsRow
+        v-for="event in BOOK_REQUEST_PUSH_EVENTS"
+        :key="event"
+        :label="t(`settings.system.requests.push.event.${EVENT_KEYS[event]}`)"
+        :hint="t(`settings.system.requests.push.event.${EVENT_KEYS[event]}Short`)"
+      >
+        <ToggleSwitch
+          :model-value="settings.events.includes(event)"
+          :aria-label="t(`settings.system.requests.push.event.${EVENT_KEYS[event]}`)"
+          @update:model-value="(on: boolean) => handleEventChange(event, on)"
+        />
+      </SettingsRow>
+
+      <SettingsRow
+        control-id="push-priority"
+        :label="t('settings.system.requests.push.priority')"
+        :hint="t('settings.system.requests.push.priorityShort')"
+      >
+        <select id="push-priority" :value="settings.priority" class="select-field w-full md:w-48" @change="handlePriorityChange">
+          <option v-for="p in BOOK_REQUEST_PUSH_PRIORITIES" :key="p" :value="p">
+            {{ t(`settings.system.requests.push.priorities.${PRIORITY_KEYS[p]}`) }}
+          </option>
+        </select>
+      </SettingsRow>
+    </div>
+  </section>
+</template>
