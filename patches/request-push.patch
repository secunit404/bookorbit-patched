index 0000000..4ac0f0e
--- /dev/null
+++ b/client/src/features/book-requests/composables/useRequestPush.ts
@@ -0,0 +1,81 @@
+import { ref } from 'vue'
+import { api } from '@/lib/api'
+import { DEFAULT_BOOK_REQUEST_PUSH_EVENTS } from '@bookorbit/types'
+import type {
+  BookRequestPushSettings,
+  TestBookRequestPushPayload,
+  TestBookRequestPushResult,
+  UpdateBookRequestPushSettingsPayload,
+} from '@bookorbit/types'
+
+const BASE_PATH = '/api/v1/admin/book-request-push'
+
+export function useRequestPush() {
+  const settings = ref<BookRequestPushSettings>({
+    enabled: false,
+    events: [...DEFAULT_BOOK_REQUEST_PUSH_EVENTS],
+    priority: 0,
+    hasAppToken: false,
+    hasUserKey: false,
+    encryptionConfigured: true,
+  })
+  const loading = ref(false)
+  const loadFailed = ref(false)
+
+  async function fetchSettings(): Promise<void> {
+    loading.value = true
+    loadFailed.value = false
+    try {
+      const res = await api(BASE_PATH)
+      if (!res.ok) {
+        loadFailed.value = true
+        return
+      }
+      settings.value = (await res.json()) as BookRequestPushSettings
+    } catch {
+      loadFailed.value = true
+    } finally {
+      loading.value = false
+    }
+  }
+
+  async function put(payload: UpdateBookRequestPushSettingsPayload): Promise<boolean> {
+    try {
+      const res = await api(BASE_PATH, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(payload),
+      })
+      if (!res.ok) return false
+      settings.value = (await res.json()) as BookRequestPushSettings
+      return true
+    } catch {
+      return false
+    }
+  }
+
+  /** Serialised for the same reason the automation saves are: each adopts the whole reply. */
+  let queue: Promise<unknown> = Promise.resolve()
+
+  function save(payload: UpdateBookRequestPushSettingsPayload): Promise<boolean> {
+    const done = queue.then(() => put(payload))
+    queue = done
+    return done
+  }
+
+  async function sendTest(payload: TestBookRequestPushPayload): Promise<TestBookRequestPushResult> {
+    try {
+      const res = await api(`${BASE_PATH}/test`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(payload),
+      })
+      if (!res.ok) return { ok: false }
+      return (await res.json()) as TestBookRequestPushResult
+    } catch {
+      return { ok: false }
+    }
+  }
+
+  return { settings, loading, loadFailed, fetchSettings, save, sendTest }
+}
