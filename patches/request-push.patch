+import { NotificationType } from "./notification";
+
+/**
+ * Pushover delivery for the request notifications an operator would otherwise only see in the
+ * bell. Stored as `app_settings` rows like the automation knobs; the two Pushover keys are
+ * encrypted with the same key as every other third-party secret the request feature holds.
+ */
+export const BOOK_REQUEST_PUSH_SETTING_KEYS = {
+  ENABLED: "book_request_push_enabled",
+  EVENTS: "book_request_push_events",
+  PRIORITY: "book_request_push_priority",
+  APP_TOKEN: "book_request_push_app_token",
+  USER_KEY: "book_request_push_user_key",
+} as const;
+
+/**
+ * The request events worth a phone buzz. Approved and rejected are left out: they are news for the
+ * requester, and the operator is the one who caused them.
+ */
+export const BOOK_REQUEST_PUSH_EVENTS = [
+  NotificationType.BookRequestFailed,
+  NotificationType.BookRequestNeedsReview,
+  NotificationType.BookRequestNeedsRelease,
+  NotificationType.BookRequestSubmitted,
+  NotificationType.BookRequestAvailable,
+] as const;
+export type BookRequestPushEvent = (typeof BOOK_REQUEST_PUSH_EVENTS)[number];
+
+/** Pushover's own scale, minus 2 (emergency), which needs retry/expire handling this does not do. */
+export const BOOK_REQUEST_PUSH_PRIORITIES = [-1, 0, 1] as const;
+export type BookRequestPushPriority = (typeof BOOK_REQUEST_PUSH_PRIORITIES)[number];
+
+export interface BookRequestPushSettings {
+  enabled: boolean;
+  events: BookRequestPushEvent[];
+  priority: BookRequestPushPriority;
+  hasAppToken: boolean;
+  hasUserKey: boolean;
+  encryptionConfigured: boolean;
+}
+
+/** Omitted fields are left as they are. An empty string clears a stored key. */
+export interface UpdateBookRequestPushSettingsPayload {
+  enabled?: boolean;
+  events?: BookRequestPushEvent[];
+  priority?: BookRequestPushPriority;
+  appToken?: string;
+  userKey?: string;
+}
+
+/** Keys typed into the form but not saved yet are tried as typed; anything omitted uses the stored one. */
+export interface TestBookRequestPushPayload {
+  appToken?: string;
+  userKey?: string;
+}
+
+export interface TestBookRequestPushResult {
+  ok: boolean;
+  error?: string;
+}
+
+export const DEFAULT_BOOK_REQUEST_PUSH_EVENTS: BookRequestPushEvent[] = [
+  NotificationType.BookRequestFailed,
+  NotificationType.BookRequestNeedsReview,
+  NotificationType.BookRequestNeedsRelease,
+];
