@@ -0,0 +1,35 @@
+import { Body, Controller, Get, HttpCode, HttpStatus, Post, Put } from '@nestjs/common';
+import { AuditAction, AuditResource, Permission } from '@bookorbit/types';
+
+import { Auditable } from '../../common/decorators/auditable.decorator';
+import { RequirePermission } from '../../common/decorators/require-permission.decorator';
+import { TestPushDto, UpdatePushSettingsDto } from './dto/push-settings.dto';
+import { RequestPushService } from './push/request-push.service';
+
+/** Instance configuration holding third-party keys, so `ManageAppSettings` like the automation knobs. */
+@Controller('admin/book-request-push')
+@RequirePermission(Permission.ManageAppSettings)
+export class BookRequestPushController {
+  constructor(private readonly push: RequestPushService) {}
+
+  @Get()
+  get() {
+    return this.push.get();
+  }
+
+  @Put()
+  @Auditable({
+    action: AuditAction.AppSettingsUpdate,
+    resource: AuditResource.AppSettings,
+    description: 'Updated book request push notification settings',
+  })
+  update(@Body() dto: UpdatePushSettingsDto) {
+    return this.push.update(dto);
+  }
+
+  @Post('test')
+  @HttpCode(HttpStatus.OK)
+  test(@Body() dto: TestPushDto) {
+    return this.push.test(dto);
+  }
+}
