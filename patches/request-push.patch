@@ -0,0 +1,47 @@
+import { Injectable } from '@nestjs/common';
+
+const PUSHOVER_URL = 'https://api.pushover.net/1/messages.json';
+const TIMEOUT_MS = 10_000;
+/** Pushover's own limits. Over them it refuses the whole message rather than cutting it. */
+const MAX_TITLE = 250;
+const MAX_MESSAGE = 1024;
+const MAX_URL = 512;
+
+export interface PushoverMessage {
+  appToken: string;
+  userKey: string;
+  title: string;
+  message: string;
+  priority: number;
+  url?: string;
+}
+
+export class PushoverError extends Error {}
+
+@Injectable()
+export class PushoverClient {
+  async send(msg: PushoverMessage): Promise<void> {
+    const body = new URLSearchParams({
+      token: msg.appToken,
+      user: msg.userKey,
+      title: msg.title.slice(0, MAX_TITLE),
+      message: msg.message.slice(0, MAX_MESSAGE) || msg.title.slice(0, MAX_MESSAGE),
+      priority: String(msg.priority),
+    });
+    if (msg.url && msg.url.length <= MAX_URL) body.set('url', msg.url);
+
+    let res: Response;
+    try {
+      res = await fetch(PUSHOVER_URL, { method: 'POST', body, signal: AbortSignal.timeout(TIMEOUT_MS) });
+    } catch (err) {
+      throw new PushoverError(`Pushover could not be reached: ${err instanceof Error ? err.message : String(err)}`);
+    }
+    if (res.ok) return;
+
+    const detail = await res
+      .json()
+      .then((json: { errors?: unknown }) => (Array.isArray(json.errors) ? json.errors.join('; ') : ''))
+      .catch(() => '');
+    throw new PushoverError(detail || `Pushover answered HTTP ${res.status}`);
+  }
+}
diff --git a/server/src/modules/book-request/push/request-push.service.ts b/server/src/modules/book-request/push/request-push.service.ts
new file mode 100644
index 0000000..3f0fe02
--- /dev/null
+++ b/server/src/modules/book-request/push/request-push.service.ts
@@ -0,0 +1,188 @@
+import { BadRequestException, Injectable, Logger } from '@nestjs/common';
+import { ConfigService } from '@nestjs/config';
+import {
+  BOOK_REQUEST_PUSH_EVENTS,
+  BOOK_REQUEST_PUSH_PRIORITIES,
+  BOOK_REQUEST_PUSH_SETTING_KEYS,
+  DEFAULT_BOOK_REQUEST_PUSH_EVENTS,
+} from '@bookorbit/types';
+import type {
+  BookRequestPushEvent,
+  BookRequestPushPriority,
+  BookRequestPushSettings,
+  NotificationType,
+  TestBookRequestPushPayload,
+  TestBookRequestPushResult,
+  UpdateBookRequestPushSettingsPayload,
+} from '@bookorbit/types';
+
+import { sanitizeLogValue } from '../../../common/utils/log-sanitize.utils';
+import { AppSettingsService } from '../../app-settings/app-settings.service';
+import { RequestCredentialService } from '../request-credential.service';
+import { PushoverClient } from './pushover.client';
+
+const KEYS = BOOK_REQUEST_PUSH_SETTING_KEYS;
+
+export interface PushPayload {
+  title: string;
+  message: string;
+  actionUrl?: string;
+}
+
+interface StoredPushSettings {
+  enabled: boolean;
+  events: BookRequestPushEvent[];
+  priority: BookRequestPushPriority;
+  appToken: string;
+  userKey: string;
+}
+
+/**
+ * Sends request notifications to the operator's phone through Pushover.
+ *
+ * Every failure here is logged and swallowed: the in-app notification has already been written,
+ * and a push that did not go out must never fail or slow the request it is about.
+ */
+@Injectable()
+export class RequestPushService {
+  private readonly logger = new Logger(RequestPushService.name);
+
+  constructor(
+    private readonly appSettings: AppSettingsService,
+    private readonly credentials: RequestCredentialService,
+    private readonly pushover: PushoverClient,
+    private readonly config: ConfigService,
+  ) {}
+
+  async get(): Promise<BookRequestPushSettings> {
+    const stored = await this.readStored();
+    return {
+      enabled: stored.enabled,
+      events: stored.events,
+      priority: stored.priority,
+      hasAppToken: stored.appToken !== '',
+      hasUserKey: stored.userKey !== '',
+      encryptionConfigured: this.credentials.isConfigured(),
+    };
+  }
+
+  async update(payload: UpdateBookRequestPushSettingsPayload): Promise<BookRequestPushSettings> {
+    const writes: Array<Promise<void>> = [];
+
+    if (payload.enabled !== undefined) writes.push(this.appSettings.setValue(KEYS.ENABLED, String(payload.enabled)));
+    if (payload.events !== undefined) {
+      const events = payload.events.filter(isPushEvent);
+      if (events.length !== payload.events.length) throw new BadRequestException('Unknown notification event');
+      writes.push(this.appSettings.setValue(KEYS.EVENTS, JSON.stringify([...new Set(events)])));
+    }
+    if (payload.priority !== undefined) {
+      if (!isPriority(payload.priority)) throw new BadRequestException('Priority must be -1, 0 or 1');
+      writes.push(this.appSettings.setValue(KEYS.PRIORITY, String(payload.priority)));
+    }
+    if (payload.appToken !== undefined) writes.push(this.writeSecret(KEYS.APP_TOKEN, payload.appToken));
+    if (payload.userKey !== undefined) writes.push(this.writeSecret(KEYS.USER_KEY, payload.userKey));
+
+    await Promise.all(writes);
+    return this.get();
+  }
+
+  async test(payload: TestBookRequestPushPayload): Promise<TestBookRequestPushResult> {
+    let stored: StoredPushSettings;
+    try {
+      stored = await this.readStored(true);
+    } catch (err) {
+      return { ok: false, error: errorMessage(err) };
+    }
+    const appToken = payload.appToken?.trim() || stored.appToken;
+    const userKey = payload.userKey?.trim() || stored.userKey;
+    if (!appToken || !userKey) return { ok: false, error: 'Both the application token and the user key are needed' };
+
+    try {
+      await this.pushover.send({
+        appToken,
+        userKey,
+        title: 'BookOrbit',
+        message: 'Test notification. Request alerts will arrive like this.',
+        priority: stored.priority,
+        url: this.absoluteUrl('/settings/admin/requests?tab=notifications'),
+      });
+      return { ok: true };
+    } catch (err) {
+      return { ok: false, error: errorMessage(err) };
+    }
+  }
+
+  /** Never throws and never needs awaiting by the caller. */
+  async forward(type: NotificationType, payload: PushPayload): Promise<void> {
+    try {
+      const stored = await this.readStored(true);
+      if (!stored.enabled || !stored.appToken || !stored.userKey) return;
+      if (!stored.events.includes(type as BookRequestPushEvent)) return;
+
+      await this.pushover.send({
+        appToken: stored.appToken,
+        userKey: stored.userKey,
+        title: payload.title,
+        message: payload.message,
+        priority: stored.priority,
+        url: payload.actionUrl ? this.absoluteUrl(payload.actionUrl) : undefined,
+      });
+    } catch (err) {
+      this.logger.warn(`[book_request.push] [fail] type=${type} error="${sanitizeLogValue(errorMessage(err))}" - push notification not sent`);
+    }
+  }
+
+  private async readStored(decrypt = false): Promise<StoredPushSettings> {
+    const values = await this.appSettings.getValues(Object.values(KEYS));
+    const appToken = values.get(KEYS.APP_TOKEN) ?? '';
+    const userKey = values.get(KEYS.USER_KEY) ?? '';
+    return {
+      enabled: values.get(KEYS.ENABLED) === 'true',
+      events: parseEvents(values.get(KEYS.EVENTS)),
+      priority: parsePriority(values.get(KEYS.PRIORITY)),
+      appToken: decrypt && appToken ? this.credentials.decrypt(appToken) : appToken,
+      userKey: decrypt && userKey ? this.credentials.decrypt(userKey) : userKey,
+    };
+  }
+
+  private writeSecret(key: string, value: string): Promise<void> {
+    const trimmed = value.trim();
+    return this.appSettings.setValue(key, trimmed === '' ? '' : this.credentials.encrypt(trimmed));
+  }
+
+  private absoluteUrl(path: string): string {
+    const base = (this.config.get<string>('app.appUrl') ?? '').replace(/\/+$/, '');
+    return `${base}${path}`;
+  }
+}
+
+function isPushEvent(value: unknown): value is BookRequestPushEvent {
+  return (BOOK_REQUEST_PUSH_EVENTS as readonly unknown[]).includes(value);
+}
+
+function isPriority(value: unknown): value is BookRequestPushPriority {
+  return (BOOK_REQUEST_PUSH_PRIORITIES as readonly unknown[]).includes(value);
+}
+
+function parseEvents(raw: string | undefined): BookRequestPushEvent[] {
+  if (raw === undefined) return [...DEFAULT_BOOK_REQUEST_PUSH_EVENTS];
+  try {
+    const parsed: unknown = JSON.parse(raw);
+    return Array.isArray(parsed) ? parsed.filter(isPushEvent) : [...DEFAULT_BOOK_REQUEST_PUSH_EVENTS];
+  } catch {
+    return [...DEFAULT_BOOK_REQUEST_PUSH_EVENTS];
+  }
+}
+
+function parsePriority(raw: string | undefined): BookRequestPushPriority {
+  const parsed = raw === undefined ? NaN : Number(raw);
+  return isPriority(parsed) ? parsed : 0;
+}
+
+function errorMessage(err: unknown): string {
+  if (err instanceof BadRequestException) {
+    const response = err.getResponse();
+    if (typeof response === 'object' && response !== null && 'message' in response) return String(response.message);
+  }
+  return err instanceof Error ? err.message : String(err);
+}
