+  describe('buildSeedState', () => {
+    function seedDb(rows: { file?: unknown[]; progress?: unknown[]; status?: unknown[] }) {
+      const db = makeDb();
+      db.select
+        .mockReturnValueOnce(makeSelectChain(rows.file ?? [{ fileId: 495 }]) as never)
+        .mockReturnValueOnce(makeSelectChain(rows.progress ?? []) as never)
+        .mockReturnValueOnce(makeSelectChain(rows.status ?? []) as never);
+      return db;
+    }
+
+    it('returns null when two-way progress sync is off', async () => {
+      settingsService.getSettings.mockResolvedValue({ twoWayProgressSync: false });
+      const service = makeService(seedDb({}));
+
+      expect(await service.buildSeedState(2, 249, 'ent-249')).toBeNull();
+    });
+
+    it('seeds the bookmark from hub progress so the device does not start at zero', async () => {
+      settingsService.getSettings.mockResolvedValue({ twoWayProgressSync: true });
+      progressBridge.cfiToKoboBookmark.mockResolvedValue({
+        source: 'OEBPS/ch3.xhtml',
+        value: 'kobo.12.4',
+        contentSourceProgressPercent: 18,
+      });
+      const db = seedDb({
+        progress: [{ cfi: 'epubcfi(/6/16!/4)', percentage: 44, updatedAt: new Date('2026-09-20T09:05:50.000Z') }],
+        status: [{ status: 'reading', updatedAt: new Date('2026-09-20T08:00:00.000Z') }],
+      });
+
+      const state = (await makeService(db).buildSeedState(2, 249, 'ent-249')) as any;
+
+      expect(state.EntitlementId).toBe('ent-249');
+      expect(state.CurrentBookmark.ProgressPercent).toBe(44);
+      expect(state.CurrentBookmark.Location).toEqual({ Source: 'OEBPS/ch3.xhtml', Type: 'KoboSpan', Value: 'kobo.12.4' });
+      expect(state.CurrentBookmark.ContentSourceProgressPercent).toBe(18);
+      expect(state.StatusInfo).toMatchObject({ Status: 'Reading', TimesStartedReading: 1 });
+      // The newest hub write, so a device pushing an older position cannot win on timestamp.
+      expect(state.LastModified).toBe('2026-09-20T09:05:50.000Z');
+    });
+
+    it('still seeds the percentage when the cfi cannot be converted to a KoboSpan', async () => {
+      settingsService.getSettings.mockResolvedValue({ twoWayProgressSync: true });
+      progressBridge.cfiToKoboBookmark.mockResolvedValue(null);
+      const db = seedDb({
+        progress: [{ cfi: 'epubcfi(/6/16!/4)', percentage: 44, updatedAt: new Date('2026-09-20T09:05:50.000Z') }],
+        status: [{ status: 'reading', updatedAt: new Date('2026-09-20T08:00:00.000Z') }],
+      });
+
+      const state = (await makeService(db).buildSeedState(2, 249, 'ent-249')) as any;
+
+      expect(state.CurrentBookmark.ProgressPercent).toBe(44);
+      expect(state.CurrentBookmark.Location).toBeUndefined();
+    });
+
+    it('returns null for an untouched book so the zeroed default is used', async () => {
+      settingsService.getSettings.mockResolvedValue({ twoWayProgressSync: true });
+      const db = seedDb({ progress: [{ cfi: null, percentage: 0, updatedAt: new Date() }], status: [{ status: 'unread', updatedAt: new Date() }] });
+
+      expect(await makeService(db).buildSeedState(2, 249, 'ent-249')).toBeNull();
+    });
+
+    it('returns null when the book has no epub or kepub primary file', async () => {
+      settingsService.getSettings.mockResolvedValue({ twoWayProgressSync: true });
+
+      expect(await makeService(seedDb({ file: [] })).buildSeedState(2, 249, 'ent-249')).toBeNull();
+    });
+  });
 });
