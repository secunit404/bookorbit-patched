diff --git a/server/src/modules/book-request/push/pushover.client.test.ts b/server/src/modules/book-request/push/pushover.client.test.ts
new file mode 100644
index 0000000..77b5eae
--- /dev/null
+++ b/server/src/modules/book-request/push/pushover.client.test.ts
@@ -0,0 +1,48 @@
+import { PushoverClient, PushoverError } from './pushover.client';
+
+const msg = { appToken: 'app', userKey: 'user', title: 'Failed', message: 'Dune', priority: 1, url: 'https://books.example.com/requests' };
+
+describe('PushoverClient', () => {
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('posts the message form-encoded', async () => {
+    const fetch = vi.fn().mockResolvedValue(new Response('{"status":1}', { status: 200 }));
+    vi.stubGlobal('fetch', fetch);
+
+    await new PushoverClient().send(msg);
+
+    const [url, init] = fetch.mock.calls[0] as [string, RequestInit];
+    expect(url).toBe('https://api.pushover.net/1/messages.json');
+    expect(Object.fromEntries(init.body as URLSearchParams)).toEqual({
+      token: 'app',
+      user: 'user',
+      title: 'Failed',
+      message: 'Dune',
+      priority: '1',
+      url: 'https://books.example.com/requests',
+    });
+  });
+
+  it('cuts text to the lengths Pushover accepts', async () => {
+    const fetch = vi.fn().mockResolvedValue(new Response('{}', { status: 200 }));
+    vi.stubGlobal('fetch', fetch);
+
+    await new PushoverClient().send({ ...msg, title: 't'.repeat(300), message: 'm'.repeat(2000) });
+
+    const body = (fetch.mock.calls[0] as [string, RequestInit])[1].body as URLSearchParams;
+    expect(body.get('title')).toHaveLength(250);
+    expect(body.get('message')).toHaveLength(1024);
+  });
+
+  it('reports the errors Pushover names', async () => {
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(new Response('{"status":0,"errors":["user key is invalid"]}', { status: 400 })));
+
+    await expect(new PushoverClient().send(msg)).rejects.toThrow(new PushoverError('user key is invalid'));
+  });
+
+  it('reports a network failure', async () => {
+    vi.stubGlobal('fetch', vi.fn().mockRejectedValue(new Error('ENOTFOUND')));
+
+    await expect(new PushoverClient().send(msg)).rejects.toThrow(/could not be reached: ENOTFOUND/);
+  });
+});
diff --git a/server/src/modules/book-request/push/request-push.service.test.ts b/server/src/modules/book-request/push/request-push.service.test.ts
new file mode 100644
index 0000000..2fb0a5b
--- /dev/null
+++ b/server/src/modules/book-request/push/request-push.service.test.ts
@@ -0,0 +1,200 @@
+import { BadRequestException } from '@nestjs/common';
+import { BOOK_REQUEST_PUSH_SETTING_KEYS as KEYS, NotificationType } from '@bookorbit/types';
+
+import { PushoverError } from './pushover.client';
+import { RequestPushService } from './request-push.service';
+
+function makeService(initial: Record<string, string> = {}, { encryption = true } = {}) {
+  const store = new Map(Object.entries(initial));
+  const appSettings = {
+    getValues: vi.fn((keys: string[]) => Promise.resolve(new Map(keys.filter((k) => store.has(k)).map((k) => [k, store.get(k)!])))),
+    setValue: vi.fn((key: string, value: string) => {
+      store.set(key, value);
+      return Promise.resolve();
+    }),
+  };
+  const credentials = {
+    isConfigured: () => encryption,
+    encrypt: vi.fn((plain: string) => {
+      if (!encryption) throw new BadRequestException({ message: 'Set BOOK_REQUEST_ENCRYPTION_KEY', errorCode: 'REQUEST_ENCRYPTION_KEY_MISSING' });
+      return `enc:${plain}`;
+    }),
+    decrypt: vi.fn((cipher: string) => cipher.replace(/^enc:/, '')),
+  };
+  const pushover = { send: vi.fn().mockResolvedValue(undefined) };
+  const config = { get: vi.fn().mockReturnValue('https://books.example.com/') };
+  const service = new RequestPushService(appSettings as never, credentials as never, pushover as never, config as never);
+  return { service, store, pushover, credentials };
+}
+
+const configured = {
+  [KEYS.ENABLED]: 'true',
+  [KEYS.APP_TOKEN]: 'enc:app',
+  [KEYS.USER_KEY]: 'enc:user',
+};
+
+describe('RequestPushService.get', () => {
+  it('defaults to off with failures, reviews and missing releases selected', async () => {
+    const { service } = makeService();
+
+    expect(await service.get()).toEqual({
+      enabled: false,
+      events: [NotificationType.BookRequestFailed, NotificationType.BookRequestNeedsReview, NotificationType.BookRequestNeedsRelease],
+      priority: 0,
+      hasAppToken: false,
+      hasUserKey: false,
+      encryptionConfigured: true,
+    });
+  });
+
+  it('reports stored keys without returning them', async () => {
+    const { service } = makeService(configured);
+
+    const settings = await service.get();
+
+    expect(settings).toMatchObject({ hasAppToken: true, hasUserKey: true });
+    expect(JSON.stringify(settings)).not.toContain('app');
+  });
+
+  it('falls back to defaults for hand-edited nonsense', async () => {
+    const { service } = makeService({ [KEYS.EVENTS]: '{not json', [KEYS.PRIORITY]: '2' });
+
+    const settings = await service.get();
+
+    expect(settings.events).toHaveLength(3);
+    expect(settings.priority).toBe(0);
+  });
+});
+
+describe('RequestPushService.update', () => {
+  it('stores keys encrypted and trimmed', async () => {
+    const { service, store } = makeService();
+
+    await service.update({ appToken: ' app ', userKey: 'user' });
+
+    expect(store.get(KEYS.APP_TOKEN)).toBe('enc:app');
+    expect(store.get(KEYS.USER_KEY)).toBe('enc:user');
+  });
+
+  it('clears a key on an empty string', async () => {
+    const { service, store } = makeService(configured);
+
+    const settings = await service.update({ appToken: '' });
+
+    expect(store.get(KEYS.APP_TOKEN)).toBe('');
+    expect(settings.hasAppToken).toBe(false);
+  });
+
+  it('deduplicates events', async () => {
+    const { service } = makeService();
+
+    const settings = await service.update({ events: [NotificationType.BookRequestFailed, NotificationType.BookRequestFailed] });
+
+    expect(settings.events).toEqual([NotificationType.BookRequestFailed]);
+  });
+
+  it('refuses an event outside the push list', async () => {
+    const { service } = makeService();
+
+    await expect(service.update({ events: [NotificationType.BookRequestApproved as never] })).rejects.toThrow(BadRequestException);
+  });
+
+  it('refuses emergency priority', async () => {
+    const { service } = makeService();
+
+    await expect(service.update({ priority: 2 as never })).rejects.toThrow(BadRequestException);
+  });
+
+  it('refuses to store a key without an encryption key', async () => {
+    const { service } = makeService({}, { encryption: false });
+
+    await expect(service.update({ appToken: 'app' })).rejects.toThrow(BadRequestException);
+  });
+});
+
+describe('RequestPushService.forward', () => {
+  it('sends a selected event with an absolute link', async () => {
+    const { service, pushover } = makeService(configured);
+
+    await service.forward(NotificationType.BookRequestFailed, { title: 'Failed', message: 'Dune', actionUrl: '/requests' });
+
+    expect(pushover.send).toHaveBeenCalledWith({
+      appToken: 'app',
+      userKey: 'user',
+      title: 'Failed',
+      message: 'Dune',
+      priority: 0,
+      url: 'https://books.example.com/requests',
+    });
+  });
+
+  it('stays quiet for an event that is not selected', async () => {
+    const { service, pushover } = makeService(configured);
+
+    await service.forward(NotificationType.BookRequestSubmitted, { title: 'New', message: 'Dune' });
+
+    expect(pushover.send).not.toHaveBeenCalled();
+  });
+
+  it('stays quiet when switched off', async () => {
+    const { service, pushover } = makeService({ ...configured, [KEYS.ENABLED]: 'false' });
+
+    await service.forward(NotificationType.BookRequestFailed, { title: 'Failed', message: 'Dune' });
+
+    expect(pushover.send).not.toHaveBeenCalled();
+  });
+
+  it('stays quiet without both keys', async () => {
+    const { service, pushover } = makeService({ ...configured, [KEYS.USER_KEY]: '' });
+
+    await service.forward(NotificationType.BookRequestFailed, { title: 'Failed', message: 'Dune' });
+
+    expect(pushover.send).not.toHaveBeenCalled();
+  });
+
+  it('swallows a Pushover failure', async () => {
+    const { service, pushover } = makeService(configured);
+    pushover.send.mockRejectedValue(new PushoverError('user key is invalid'));
+
+    await expect(service.forward(NotificationType.BookRequestFailed, { title: 'Failed', message: 'Dune' })).resolves.toBeUndefined();
+  });
+
+  it('swallows an undecryptable key', async () => {
+    const { service, credentials, pushover } = makeService(configured);
+    credentials.decrypt.mockImplementation(() => {
+      throw new BadRequestException('key changed');
+    });
+
+    await expect(service.forward(NotificationType.BookRequestFailed, { title: 'Failed', message: 'Dune' })).resolves.toBeUndefined();
+    expect(pushover.send).not.toHaveBeenCalled();
+  });
+});
+
+describe('RequestPushService.test', () => {
+  it('prefers keys typed into the form over stored ones', async () => {
+    const { service, pushover } = makeService(configured);
+
+    expect(await service.test({ appToken: 'typed-app' })).toEqual({ ok: true });
+    expect(pushover.send).toHaveBeenCalledWith(expect.objectContaining({ appToken: 'typed-app', userKey: 'user' }));
+  });
+
+  it('works while push is switched off, so keys can be checked first', async () => {
+    const { service, pushover } = makeService({ ...configured, [KEYS.ENABLED]: 'false' });
+
+    expect(await service.test({})).toEqual({ ok: true });
+    expect(pushover.send).toHaveBeenCalled();
+  });
+
+  it('says what is missing', async () => {
+    const { service } = makeService();
+
+    expect(await service.test({ appToken: 'app' })).toEqual({ ok: false, error: expect.stringContaining('user key') });
+  });
+
+  it('passes on what Pushover refused', async () => {
+    const { service, pushover } = makeService(configured);
+    pushover.send.mockRejectedValue(new PushoverError('application token is invalid'));
+
+    expect(await service.test({})).toEqual({ ok: false, error: 'application token is invalid' });
+  });
+});
