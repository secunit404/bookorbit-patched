@@ -0,0 +1,109 @@
+import { flushPromises, mount } from '@vue/test-utils'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { NotificationType } from '@bookorbit/types'
+import type { BookRequestPushSettings } from '@bookorbit/types'
+
+const { apiMock } = vi.hoisted(() => ({ apiMock: vi.fn<(url: string, init?: RequestInit) => Promise<Response>>() }))
+
+vi.mock('@/lib/api', () => ({ api: apiMock }))
+vi.mock('vue-sonner', () => ({ toast: { success: vi.fn<(message: string) => void>(), error: vi.fn<(message: string) => void>() } }))
+
+import { toast } from 'vue-sonner'
+import RequestPushPanel from '../RequestPushPanel.vue'
+
+const PATH = '/api/v1/admin/book-request-push'
+
+function settings(overrides: Partial<BookRequestPushSettings> = {}): BookRequestPushSettings {
+  return {
+    enabled: false,
+    events: [NotificationType.BookRequestFailed],
+    priority: 0,
+    hasAppToken: false,
+    hasUserKey: false,
+    encryptionConfigured: true,
+    ...overrides,
+  }
+}
+
+function response(body: unknown, ok = true): Response {
+  return { ok, status: ok ? 200 : 500, json: vi.fn<() => Promise<unknown>>().mockResolvedValue(body) } as unknown as Response
+}
+
+async function mountPanel(loaded = settings()) {
+  apiMock.mockImplementation(async (_url, init) => response(init?.method === 'PUT' ? { ...loaded, ...JSON.parse(String(init.body)) } : loaded))
+  const wrapper = mount(RequestPushPanel)
+  await flushPromises()
+  return wrapper
+}
+
+function lastCall(): [string, Record<string, unknown>] {
+  const [url, init] = apiMock.mock.calls.at(-1)!
+  return [url, JSON.parse(String(init?.body)) as Record<string, unknown>]
+}
+
+function buttonByText(wrapper: Awaited<ReturnType<typeof mountPanel>>, text: string) {
+  return wrapper.findAll('button').find((b) => b.text().includes(text))!
+}
+
+describe('RequestPushPanel', () => {
+  beforeEach(() => {
+    apiMock.mockReset()
+    vi.mocked(toast.success).mockClear()
+    vi.mocked(toast.error).mockClear()
+  })
+
+  it('keeps the switch off until both keys are stored', async () => {
+    const wrapper = await mountPanel()
+
+    expect(wrapper.find('[aria-label="Send push notifications"]').attributes('disabled')).toBeDefined()
+  })
+
+  it('saves only the keys that were typed', async () => {
+    const wrapper = await mountPanel(settings({ hasUserKey: true }))
+
+    await wrapper.find('#push-app-token').setValue('app-token')
+    await buttonByText(wrapper, 'Save keys').trigger('click')
+    await flushPromises()
+
+    expect(lastCall()).toEqual([PATH, { appToken: 'app-token' }])
+    expect((wrapper.find('#push-app-token').element as HTMLInputElement).value).toBe('')
+  })
+
+  it('adds an event when its switch is turned on', async () => {
+    const wrapper = await mountPanel()
+
+    await wrapper.find('[aria-label="A request is submitted"]').trigger('click')
+    await flushPromises()
+
+    expect(lastCall()[1]).toEqual({ events: [NotificationType.BookRequestFailed, NotificationType.BookRequestSubmitted] })
+  })
+
+  it('tests with typed keys before they are saved', async () => {
+    const wrapper = await mountPanel(settings({ hasUserKey: true }))
+    apiMock.mockResolvedValueOnce(response({ ok: true }))
+
+    await wrapper.find('#push-app-token').setValue('typed')
+    await buttonByText(wrapper, 'Send test').trigger('click')
+    await flushPromises()
+
+    expect(lastCall()).toEqual([`${PATH}/test`, { appToken: 'typed' }])
+    expect(toast.success).toHaveBeenCalledWith('Test notification sent')
+  })
+
+  it("shows Pushover's reason when a test fails", async () => {
+    const wrapper = await mountPanel(settings({ hasAppToken: true, hasUserKey: true }))
+    apiMock.mockResolvedValueOnce(response({ ok: false, error: 'user key is invalid' }))
+
+    await buttonByText(wrapper, 'Send test').trigger('click')
+    await flushPromises()
+
+    expect(toast.error).toHaveBeenCalledWith('Test notification failed: user key is invalid')
+  })
+
+  it('reports a missing encryption key to the page', async () => {
+    const wrapper = await mountPanel(settings({ encryptionConfigured: false }))
+
+    expect(wrapper.emitted('encryptionState')).toEqual([[false]])
+    expect(wrapper.find('#push-app-token').attributes('disabled')).toBeDefined()
+  })
+})
