diff --git a/server/src/modules/book-request/fulfillment/audiobook-assembly.ts b/server/src/modules/book-request/fulfillment/audiobook-assembly.ts
new file mode 100644
index 0000000..98d57d7
--- /dev/null
+++ b/server/src/modules/book-request/fulfillment/audiobook-assembly.ts
@@ -0,0 +1,338 @@
+import { execFile as execFileCallback } from 'node:child_process';
+import { readFile, rename, rm, writeFile } from 'node:fs/promises';
+import { basename, dirname, extname, join } from 'node:path';
+import { promisify } from 'node:util';
+import sharp from 'sharp';
+import { ISO_639_2_TO_1 } from '@bookorbit/types';
+
+import { readBoundedBytes } from '../../../common/utils/bounded-response';
+import { safeFetch } from '../../../common/utils/safe-fetch';
+
+const execFile = promisify(execFileCallback);
+
+/**
+ * What a source that serves a bare audio file knows about the book, so the file can be turned into
+ * the one shape BookOrbit reads in full: an m4b whose tags and chapter track carry it.
+ *
+ * Semantic fields rather than ffmpeg tag names, because which MP4 atom holds a narrator or a
+ * series position is this module's knowledge to keep, not every plugin's to rediscover.
+ */
+export interface AudiobookAssembly {
+  title: string | null;
+  subtitle: string | null;
+  authors: string[];
+  narrators: string[];
+  seriesName: string | null;
+  seriesIndex: string | null;
+  publisher: string | null;
+  publishedDate: string | null;
+  description: string | null;
+  genres: string[];
+  /** ISO 639-2, which is what an MP4 track's language field holds. */
+  language: string | null;
+  chapters: AudiobookChapter[];
+  coverUrl: string | null;
+}
+
+export interface AudiobookChapter {
+  title: string;
+  startMs: number;
+}
+
+/** Written beside the staged file so a transfer resumed after a restart still assembles. */
+export const ASSEMBLY_SPEC_FILE = '.bookorbit-audiobook.json';
+
+const MAX_TEXT_LENGTH = 1_000;
+const MAX_DESCRIPTION_LENGTH = 20_000;
+const MAX_PEOPLE = 20;
+const MAX_GENRES = 20;
+/** Far past any real book, low enough that a hostile list cannot become a payload. */
+const MAX_CHAPTERS = 2_000;
+const MAX_COVER_BYTES = 15 * 1024 * 1024;
+const COVER_TIMEOUT_MS = 30_000;
+const FFPROBE_TIMEOUT_MS = 60_000;
+/** A transcode of a forty-hour book on a slow NAS, with room to spare. */
+const FFMPEG_TIMEOUT_MS = 4 * 60 * 60 * 1000;
+const FFMPEG_MAX_BUFFER_BYTES = 10 * 1024 * 1024;
+const DEFAULT_AAC_KBPS = 64;
+const MIN_AAC_KBPS = 32;
+const MAX_AAC_KBPS = 128;
+/** iTunes `stik` value for an audiobook, which is what makes players file it as one. */
+const MEDIA_TYPE_AUDIOBOOK = '2';
+
+/** `ISO_639_2_TO_1` leaves out codes whose three-letter form truncates to the two, so those are named here. */
+const ISO_639_1_TO_2: Record<string, string> = {
+  ...Object.fromEntries(Object.entries(ISO_639_2_TO_1).map(([three, two]) => [two, three])),
+  af: 'afr',
+  bs: 'bos',
+  en: 'eng',
+  eo: 'epo',
+  fr: 'fra',
+  ga: 'gle',
+  gl: 'glg',
+  la: 'lat',
+  lb: 'ltz',
+  mt: 'mlt',
+  nb: 'nob',
+  nn: 'nno',
+  sw: 'swa',
+  ta: 'tam',
+  te: 'tel',
+  ur: 'urd',
+};
+
+/**
+ * What a plugin handed over, reduced to what this module will act on. Null when there is nothing
+ * worth assembling, so a plugin that sends an empty object changes nothing about the download.
+ */
+export function sanitizeAudiobookAssembly(raw: unknown): AudiobookAssembly | null {
+  if (!raw || typeof raw !== 'object') return null;
+  const input = raw as Record<string, unknown>;
+
+  const assembly: AudiobookAssembly = {
+    title: text(input.title),
+    subtitle: text(input.subtitle),
+    authors: names(input.authors, MAX_PEOPLE),
+    narrators: names(input.narrators, MAX_PEOPLE),
+    seriesName: text(input.seriesName),
+    seriesIndex: text(input.seriesIndex),
+    publisher: text(input.publisher),
+    publishedDate: text(input.publishedDate),
+    description: text(input.description, MAX_DESCRIPTION_LENGTH),
+    genres: names(input.genres, MAX_GENRES),
+    language: languageCode(input.language),
+    chapters: chapters(input.chapters),
+    coverUrl: httpsUrl(input.coverUrl),
+  };
+
+  const hasAnything = assembly.title !== null || assembly.authors.length > 0 || assembly.chapters.length > 0 || assembly.coverUrl !== null;
+  return hasAnything ? assembly : null;
+}
+
+export async function writeAssemblySpec(directory: string, assembly: AudiobookAssembly): Promise<void> {
+  await writeFile(join(directory, ASSEMBLY_SPEC_FILE), JSON.stringify(assembly), 'utf8');
+}
+
+/** Re-sanitized on the way back in: the file sat on disk, and disk is not where trust comes from. */
+export async function readAssemblySpec(directory: string): Promise<AudiobookAssembly | null> {
+  try {
+    return sanitizeAudiobookAssembly(JSON.parse(await readFile(join(directory, ASSEMBLY_SPEC_FILE), 'utf8')));
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Turns the staged audio file into a tagged m4b with chapters and cover, beside it, and removes the
+ * original. Returns the path the import should read.
+ *
+ * AAC is stream-copied. Anything else is transcoded, because an m4b holding MP3 is a file most
+ * audiobook players refuse even though ffmpeg will happily write one.
+ */
+export async function assembleAudiobook(source: string, assembly: AudiobookAssembly, signal: AbortSignal): Promise<string> {
+  const directory = dirname(source);
+  const stem = basename(source, extname(source));
+  const output = join(directory, `${stem}.m4b`);
+  const partial = join(directory, `.${stem}.part.m4b`);
+  const metadataPath = join(directory, '.bookorbit-ffmetadata.txt');
+  const coverPath = join(directory, '.bookorbit-cover.jpg');
+
+  try {
+    const probe = await probeAudio(source, signal);
+    await writeFile(metadataPath, buildFfmetadata(assembly, probe.durationMs), 'utf8');
+    const hasCover = assembly.coverUrl !== null && (await saveCover(assembly.coverUrl, coverPath, signal));
+
+    await execFile(
+      ffmpegPath(),
+      buildAssemblyArgs({ source, metadataPath, coverPath: hasCover ? coverPath : null, output: partial, probe, assembly }),
+      {
+        maxBuffer: FFMPEG_MAX_BUFFER_BYTES,
+        timeout: FFMPEG_TIMEOUT_MS,
+        signal,
+      },
+    );
+    await rename(partial, output);
+    if (output !== source) await rm(source, { force: true });
+    return output;
+  } finally {
+    await Promise.all([partial, metadataPath, coverPath, join(directory, ASSEMBLY_SPEC_FILE)].map((path) => rm(path, { force: true })));
+  }
+}
+
+export interface AudioProbe {
+  codec: string | null;
+  bitRateKbps: number | null;
+  durationMs: number | null;
+}
+
+async function probeAudio(source: string, signal: AbortSignal): Promise<AudioProbe> {
+  const { stdout } = await execFile(
+    ffprobePath(),
+    ['-v', 'error', '-select_streams', 'a:0', '-show_entries', 'stream=codec_name,bit_rate:format=duration,bit_rate', '-of', 'json', source],
+    { timeout: FFPROBE_TIMEOUT_MS, signal },
+  );
+  const data = JSON.parse(String(stdout)) as {
+    streams?: { codec_name?: string; bit_rate?: string }[];
+    format?: { duration?: string; bit_rate?: string };
+  };
+  const stream = data.streams?.[0];
+  if (!stream) throw new Error('That download holds no audio stream');
+  const bitRate = Number(stream.bit_rate ?? data.format?.bit_rate);
+  const duration = Number(data.format?.duration);
+  return {
+    codec: stream.codec_name ?? null,
+    bitRateKbps: Number.isFinite(bitRate) && bitRate > 0 ? Math.round(bitRate / 1000) : null,
+    durationMs: Number.isFinite(duration) && duration > 0 ? Math.round(duration * 1000) : null,
+  };
+}
+
+/**
+ * Never fatal: a book without its cover is still the book, and the import fetches a cover of its
+ * own from the metadata providers anyway.
+ */
+async function saveCover(url: string, path: string, signal: AbortSignal): Promise<boolean> {
+  try {
+    const response = await safeFetch(
+      url,
+      { headers: { Accept: 'image/*', 'User-Agent': 'BookOrbit' }, signal: AbortSignal.any([signal, AbortSignal.timeout(COVER_TIMEOUT_MS)]) },
+      { allowPrivate: false, pinResolvedAddress: true },
+    );
+    if (!response.ok) return false;
+    const bytes = await readBoundedBytes(response, MAX_COVER_BYTES);
+    await writeFile(path, await sharp(bytes).jpeg({ quality: 92 }).toBuffer());
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * The tags go in through an ffmetadata file rather than as `-metadata` arguments so that a
+ * description of any length and the chapter list travel the same way, and so nothing a source
+ * wrote is ever parsed as an option.
+ *
+ * Keys are the ones ffmpeg's MP4 muxer maps to iTunes atoms, which is also what the audio extractor
+ * reads back: `show` for the series and `episode_id` for its position, since a free-form `series`
+ * key is dropped from an MP4 without `use_metadata_tags`, and that flag cannot coexist with a cover.
+ */
+export function buildFfmetadata(assembly: AudiobookAssembly, durationMs: number | null): string {
+  const lines = [';FFMETADATA1'];
+  const tag = (key: string, value: string | null) => {
+    if (value) lines.push(`${key}=${escapeFfmetadata(value)}`);
+  };
+
+  const authors = assembly.authors.join(', ') || null;
+  tag('title', assembly.title);
+  tag('album', assembly.title);
+  tag('artist', authors);
+  tag('album_artist', authors);
+  tag('composer', assembly.narrators.join(', ') || null);
+  tag('show', assembly.seriesName);
+  tag('episode_id', assembly.seriesName ? assembly.seriesIndex : null);
+  tag('date', assembly.publishedDate);
+  tag('genre', assembly.genres.join(';') || null);
+  tag('description', assembly.description);
+  tag('comment', assembly.description);
+  tag('media_type', MEDIA_TYPE_AUDIOBOOK);
+
+  const ordered = assembly.chapters.filter((chapter) => durationMs === null || chapter.startMs < durationMs);
+  ordered.forEach((chapter, index) => {
+    const end = ordered[index + 1]?.startMs ?? durationMs ?? chapter.startMs + 1;
+    if (end <= chapter.startMs) return;
+    lines.push('[CHAPTER]', 'TIMEBASE=1/1000', `START=${chapter.startMs}`, `END=${end}`, `title=${escapeFfmetadata(chapter.title)}`);
+  });
+
+  return `${lines.join('\n')}\n`;
+}
+
+export function buildAssemblyArgs(input: {
+  source: string;
+  metadataPath: string;
+  coverPath: string | null;
+  output: string;
+  probe: AudioProbe;
+  assembly: AudiobookAssembly;
+}): string[] {
+  const args = ['-v', 'error', '-nostdin', '-y', '-i', input.source, '-f', 'ffmetadata', '-i', input.metadataPath];
+  if (input.coverPath) args.push('-i', input.coverPath);
+
+  args.push('-map', '0:a:0');
+  if (input.coverPath) args.push('-map', '2:v:0');
+  args.push('-map_metadata', '1', '-map_chapters', '1');
+
+  if (input.probe.codec === 'aac') {
+    args.push('-c:a', 'copy');
+  } else {
+    // Matched to the source, not raised: upsampling a low-bitrate MP3 costs disk for no audible gain.
+    const kbps = Math.min(MAX_AAC_KBPS, Math.max(MIN_AAC_KBPS, input.probe.bitRateKbps ?? DEFAULT_AAC_KBPS));
+    args.push('-c:a', 'aac', '-b:a', `${kbps}k`);
+  }
+  if (input.coverPath) args.push('-c:v', 'copy', '-disposition:v:0', 'attached_pic');
+  if (input.assembly.language) args.push('-metadata:s:a:0', `language=${input.assembly.language}`);
+
+  args.push('-movflags', '+faststart', '-f', 'mp4', input.output);
+  return args;
+}
+
+function escapeFfmetadata(value: string): string {
+  return value.replace(/[\\=;#\n]/g, (char) => `\\${char}`);
+}
+
+function text(value: unknown, maxLength = MAX_TEXT_LENGTH): string | null {
+  if (typeof value === 'number' && Number.isFinite(value)) return String(value);
+  if (typeof value !== 'string') return null;
+  // eslint-disable-next-line no-control-regex -- stripping control characters is the point
+  const cleaned = value.replace(/[\u0000-\u0009\u000b-\u001f\u007f]/g, '').trim();
+  return cleaned ? cleaned.slice(0, maxLength) : null;
+}
+
+function names(value: unknown, max: number): string[] {
+  if (!Array.isArray(value)) return [];
+  const seen = new Set<string>();
+  for (const entry of value) {
+    const name = text(entry);
+    if (name) seen.add(name.replace(/\n/g, ' '));
+    if (seen.size >= max) break;
+  }
+  return [...seen];
+}
+
+function languageCode(value: unknown): string | null {
+  const code = typeof value === 'string' ? value.trim().toLowerCase().split(/[-_]/)[0] : '';
+  if (/^[a-z]{3}$/.test(code)) return code;
+  if (/^[a-z]{2}$/.test(code)) return ISO_639_1_TO_2[code] ?? null;
+  return null;
+}
+
+function chapters(value: unknown): AudiobookChapter[] {
+  if (!Array.isArray(value)) return [];
+  const parsed: { title: string | null; startMs: number }[] = [];
+  for (const entry of value.slice(0, MAX_CHAPTERS)) {
+    if (!entry || typeof entry !== 'object') continue;
+    const startMs = Number((entry as { startMs?: unknown }).startMs);
+    if (!Number.isFinite(startMs) || startMs < 0) continue;
+    parsed.push({ title: text((entry as { title?: unknown }).title)?.replace(/\n/g, ' ') ?? null, startMs: Math.round(startMs) });
+  }
+  parsed.sort((a, b) => a.startMs - b.startMs);
+  return parsed
+    .filter((chapter, index) => index === 0 || chapter.startMs > parsed[index - 1].startMs)
+    .map((chapter, index) => ({ title: chapter.title ?? `Chapter ${index + 1}`, startMs: chapter.startMs }));
+}
+
+function httpsUrl(value: unknown): string | null {
+  if (typeof value !== 'string') return null;
+  try {
+    const url = new URL(value.trim());
+    return url.protocol === 'https:' ? url.href : null;
+  } catch {
+    return null;
+  }
+}
+
+function ffmpegPath(): string {
+  return process.env.FFMPEG_PATH || 'ffmpeg';
+}
+
+function ffprobePath(): string {
+  return process.env.FFPROBE_PATH || 'ffprobe';
+}
